# Copy to .env (or .env.local) and fill in real values. Never commit .env.
# .env IS git-ignored.

# ----- Supabase (Direct connection) -----
# JDBC needs the jdbc: prefix and removes user/password from URL — those go to USERNAME/PASSWORD vars.
SPRING_DATASOURCE_URL=jdbc:postgresql://db.cfhkqbbysroragsdeelw.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-the-password-you-set-in-supabase

# ----- If Direct fails (IPv4-only network), use Session pooler instead -----
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-eu-west-1.pooler.supabase.com:5432/postgres
# SPRING_DATASOURCE_USERNAME=postgres.cfhkqbbysroragsdeelw
# SPRING_DATASOURCE_PASSWORD=replace-with-the-password-you-set-in-supabase

# ----- Hibernate -----
# Use "validate" against Supabase (schema already created by db/supabase_init.sql).
# Use "update" for local dev where no migration script ran.
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false

# ----- HikariCP (optional overrides) -----
# HIKARI_MAX_POOL=5
# HIKARI_MIN_IDLE=1

# ----- App -----
SERVER_PORT=9090
